---
import { navLinks } from "../../data/links";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-10 h-16 transition-all duration-300 flex items-center justify-evenly p-4"
>
  <a href="/" class="flex items-center gap-2 no-underline">
    <span class="font-space-grotesk font-bold text-2xl text-white"
      >FG<span class="text-primary dot-primary">·</span></span
    >
    <span class="font-space-grotesk text-sm text-secondary">devfg</span>
  </a>
  <div class="flex items-center gap-6">
    {
      navLinks.map((l) => (
        <a
          href={isHome ? `/#${l.href.slice(1)}` : l.href}
          class:list={[
            "font-space-grotesk font-medium text-sm transition-colors duration-150 no-underline",
            pathname === l.href ? "text-white" : "text-secondary hover:text-white",
          ]}
        >
          {l.name}
        </a>
      ))
    }

    <a
      id="cta-button"
      href={isHome ? "/#contact" : "/contact"}
      class="hidden font-space-grotesk font-medium text-sm text-primary border border-primary rounded-md px-4 py-2 transition-all duration-300 hover:bg-primary hover:text-background no-underline"
    >
      Hablemos
    </a>
  </div>
</nav>

<script>
  const ctaButton = document.getElementById("cta-button");
  const navbar = document.getElementById("navbar");
  const scrollClasses = ["bg-background", "backdrop-blur-md", "border-b", "border-tertiary"];

  window.addEventListener("scroll", () => {
    const past = window.scrollY > 100;
    ctaButton.classList.toggle("hidden", !past);
    scrollClasses.forEach((c) => navbar.classList.toggle(c, past));
  });
</script>
