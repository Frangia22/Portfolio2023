<div
  id="fg-toast-region"
  class="fixed bottom-6 right-6 z-[100] flex flex-col gap-2 pointer-events-none"
  aria-live="polite"
  aria-relevant="additions"
>
</div>

<script>
  window.addEventListener("fg:toast", ((e: CustomEvent<{ message: string }>) => {
    const region = document.getElementById("fg-toast-region");
    if (!region) return;
    const el = document.createElement("div");
    el.className =
      "pointer-events-auto bg-quinary border border-primary text-white font-space-grotesk text-sm px-4 py-3 rounded-lg shadow-lg";
    el.textContent = e.detail.message;
    region.appendChild(el);
    setTimeout(() => el.remove(), 2800);
  }) as EventListener);
</script>
