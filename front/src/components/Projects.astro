---
import Image from "astro/components/Image.astro";
import projects from "../data/projects.json";
---

<section
  id="projects-section"
  style="clip-path:polygon(0 3%,100% 0,100% 100%,0 100%);"
  class="opacity-0 translate-y-5 transition-all duration-500 ease-out bg-senary py-25 px-5 md:px-10 relative"
>
  <!-- dot grid -->
  <div
    style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(0,229,255,0.08) 1px,transparent 1px);background-size:24px 24px;pointer-events:none;opacity:0.4;"
  ></div>

  <div style="max-width:1280px;margin:0 auto;">
    <!-- header -->
    <div class="text-center mb-14">
      <span class="font-jetbrains-mono text-sm text-primary block mb-3">// 02. proyectos</span>
      <h2 class="font-space-grotesk font-bold text-2xl md:text-4xl text-white mb-3 tracking-tight">
        Lo que he construido
      </h2>
      <p class="text-secondary text-lg">Productos reales, con usuarios reales.</p>
    </div>

    <!-- grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((p) => (
          <article class="group flex flex-col rounded-xl border border-tertiary bg-quinary overflow-hidden shadow-[0_0_24px_rgba(0,229,255,0.04)] transition-all duration-200 ease-out hover:border-primary/40 hover:-translate-y-1 hover:scale-[1.01] hover:shadow-[0_8px_40px_rgba(0,229,255,0.12)]">
            <!-- image -->
            <div class="h-[160px] border-b border-tertiary overflow-hidden" style="background:linear-gradient(135deg,#111118 0%,#18181F 50%,rgba(0,229,255,0.06) 100%);">
              <Image
                src={"http://localhost:4321/" + p.image}
                alt={p.title}
                width={160}
                height={160}
                class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
              />
            </div>
            <!-- body -->
            <div class="flex flex-col flex-1 gap-2 p-6">
              <div class="font-space-grotesk font-semibold text-[17px] text-white">{p.title}</div>
              <div class="font-space-grotesk text-[13px] text-secondary leading-relaxed flex-1">{p.description}</div>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {p.technologies.map((t) => (
                  <span class="font-jetbrains-mono text-[11px] text-primary bg-background border border-tertiary rounded-md px-2 py-0.5">
                    {t}
                  </span>
                ))}
              </div>
              {
                (p.url || p.github) && (
              <div class="mt-3">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="font-space-grotesk text-[14px] text-primary hover:underline">
                    Ver caso →
                  </a>
                ) : (
                  <a href={p.github} target="_blank" rel="noopener noreferrer" class="font-space-grotesk text-[14px] text-primary hover:underline">
                    Ver repo →
                  </a>
                )}
              </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("projects-section");
  const obs = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) {
        section.classList.remove("opacity-0", "translate-y-5");
        obs.disconnect();
      }
    },
    { threshold: 0.1 }
  );
  obs.observe(section);
</script>
