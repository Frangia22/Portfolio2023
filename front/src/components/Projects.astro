---
import { getContent, type Locale } from "../data/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const c = getContent(locale);
const { projects: p, ui } = c;
const featured = p.items.filter((i) => i.featured);
const clients = p.items.filter((i) => !i.featured);
const groups = [
  { title: ui.featuredProjects, items: featured },
  { title: ui.clientWebsites, items: clients },
];
---

<section
  id="projects-section"
  style="clip-path:polygon(0 3%,100% 0,100% 100%,0 100%);"
  class="reveal-pending transition-all duration-500 ease-out bg-senary py-25 px-5 md:px-10 relative"
>
  <div
    class="absolute inset-0 pointer-events-none opacity-40"
    style="background-image:radial-gradient(circle,rgba(0,229,255,0.08) 1px,transparent 1px);background-size:24px 24px;"
  >
  </div>

  <div class="max-w-7xl mx-auto relative">
    <div class="text-center mb-14">
      <span class="font-jetbrains-mono text-sm text-primary block mb-3" aria-hidden="true"
        >{p.sectionLabel}</span
      >
      <h2
        class="font-space-grotesk font-bold text-2xl md:text-4xl text-white mb-3 tracking-tight"
      >
        {p.title}
      </h2>
      <p class="text-secondary text-lg">{p.subtitle}</p>
    </div>

    {
      groups.map((group) => (
        <div class="mb-12 last:mb-0">
          <h3 class="font-space-grotesk text-primary text-sm mb-4 tracking-wide">
            {group.title}
          </h3>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.items.map((item) => (
              <article class="group flex flex-col rounded-xl border border-tertiary bg-quinary overflow-hidden shadow-[0_0_24px_rgba(0,229,255,0.04)] transition-all duration-200 ease-out hover:border-primary/40 hover:-translate-y-1 hover:scale-[1.01] hover:shadow-[0_8px_40px_rgba(0,229,255,0.12)]">
                <div
                  class="h-[160px] border-b border-tertiary overflow-hidden"
                  style="background:linear-gradient(135deg,#111118 0%,#18181F 50%,rgba(0,229,255,0.06) 100%);"
                >
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    width="640"
                    height="320"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
                  />
                </div>
                <div class="flex flex-col flex-1 gap-2 p-6">
                  <div class="font-space-grotesk font-semibold text-[17px] text-white">
                    {item.title}
                  </div>
                  <div class="font-space-grotesk text-[13px] text-secondary leading-relaxed flex-1">
                    {item.description}
                  </div>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {item.technologies.map((t) => (
                      <span class="font-jetbrains-mono text-[11px] text-primary bg-background border border-tertiary rounded-md px-2 py-0.5">
                        {t}
                      </span>
                    ))}
                  </div>
                  {(item.url || item.repo) && (
                    <div class="mt-3">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-space-grotesk text-[14px] text-primary hover:underline"
                        >
                          {ui.viewSite}
                          <span class="sr-only">{ui.opensInNewTab}</span>
                        </a>
                      ) : (
                        <a
                          href={item.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-space-grotesk text-[14px] text-primary hover:underline"
                        >
                          {ui.viewRepo}
                          <span class="sr-only">{ui.opensInNewTab}</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const section = document.getElementById("projects-section");
  if (section) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          obs.disconnect();
        }
      },
      { threshold: 0.1 },
    );
    obs.observe(section);
  }
</script>
