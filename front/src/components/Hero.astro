---
import { HeroTerminal } from "./HeroTerminal";
import { getContent, type Locale } from "../data/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const c = getContent(locale);
const { hero, social, ui, profile, terminal } = c;
const homeHash = locale === "es" ? "/es/" : "/";
---

<section
  class="min-h-screen flex items-center bg-background justify-center relative overflow-hidden px-5 md:pl-20 md:pr-10 pt-16"
>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image:linear-gradient(rgba(0,229,255,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,0.04) 1px,transparent 1px);background-size:32px 32px;"
  >
  </div>
  <div
    class="absolute pointer-events-none"
    style="right:10%;top:30%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,0.08) 0%,transparent 70%);"
  >
  </div>

  <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-16 items-center">
    <div class="flex flex-col gap-6 hero-enter">
      <div>
        <span
          class="font-jetbrains-mono text-sm text-primary bg-quinary border border-tertiary rounded-md px-3 py-1.5 inline-flex items-center gap-1.5"
        >
          {hero.badge}<span class="animate-blink" aria-hidden="true">_</span>
        </span>
      </div>

      <div
        class="inline-flex items-center gap-2 font-jetbrains-mono text-xs text-secondary"
      >
        <span
          class="w-2 h-2 rounded-full bg-primary animate-pulse"
          aria-hidden="true"></span>
        <span>{hero.status}</span>
      </div>

      <h1
        class="font-space-grotesk font-bold text-4xl sm:text-5xl lg:text-6xl text-white leading-none tracking-[-2px]"
      >
        {hero.headline}
        <br />
        <span class="text-primary">{hero.headlineAccent}</span>
      </h1>

      <p
        class="font-space-grotesk text-base md:text-lg text-secondary leading-relaxed max-w-96"
      >
        {hero.subheadline}
      </p>

      <div class="flex gap-3 flex-wrap">
        <a
          href={`${homeHash}#projects`}
          class="bg-primary text-black font-space-grotesk font-medium text-sm rounded-md px-4 py-2 cursor-pointer transition-all duration-300 hover:bg-primary-hover hover:shadow-md hover:shadow-primary/40 hover:scale-105"
          >{hero.primaryCta}</a
        >
        {
          profile.cvUrl && (
            <a
              href={profile.cvUrl}
              download
              data-track="cv_download"
              class="border border-tertiary text-secondary bg-transparent font-space-grotesk font-medium text-sm rounded-md px-4 py-2 cursor-pointer transition-all duration-300 hover:border-primary hover:text-primary"
            >
              {ui.downloadCv}
            </a>
          )
        }
        <a
          href={`https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(locale === "es" ? "Hola, me interesa tu trabajo." : "Hi, I'm interested in your work.")}`}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
          class="border border-primary text-primary bg-transparent font-space-grotesk font-medium text-sm rounded-md px-4 py-2 cursor-pointer transition-all duration-300 hover:bg-primary/8"
        >
          {hero.secondaryCta}
          <span class="sr-only">{ui.opensInNewTab}</span>
        </a>
      </div>

      <div class="flex gap-5">
        {
          social.map((link) => (
            <a
              href={link.href}
              target={link.target}
              rel="noopener noreferrer"
              class="font-space-grotesk text-sm text-secondary hover:text-white cursor-pointer transition-colors duration-150"
            >
              {link.name}
              {link.target === "_blank" && (
                <span class="sr-only">{ui.opensInNewTab}</span>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="w-full overflow-x-auto hero-enter" style="animation-delay:120ms;">
      <HeroTerminal
        client:load
        filename={terminal.heroFilename}
        profile={{
          company: profile.company,
          jobTitle: profile.jobTitle,
          location: profile.location,
        }}
      />
    </div>
  </div>
</section>

<style>
  .hero-enter {
    animation: hero-in 500ms ease-out both;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }
</style>
