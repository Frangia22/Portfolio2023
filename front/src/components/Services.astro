---
import { getContent, type Locale } from "../data/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const c = getContent(locale);
const { pillars } = c;
const contactHref = locale === "es" ? "/es/#contact" : "/#contact";
---

<section id="services-section" class="bg-senary py-25 px-5 md:px-10">
  <div class="max-w-7xl mx-auto">
    <div id="services-header" class="text-center mb-14 reveal-pending">
      <span class="font-jetbrains-mono text-sm text-primary block mb-3" aria-hidden="true"
        >{pillars.sectionLabel}</span
      >
      <h2
        class="font-space-grotesk font-bold text-2xl md:text-4xl text-white mb-4 tracking-tight leading-[1.15]"
      >
        {pillars.title}
      </h2>
      <p class="text-secondary text-lg">{pillars.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {
        pillars.items.map((s, i) => (
          <div
            class="service-card rounded-xl px-8 py-7 reveal-pending bg-quinary border border-tertiary"
            style={`transition-delay: ${i * 80}ms;`}
          >
            <div class="text-[28px] text-primary mb-3.5 font-jetbrains-mono" aria-hidden="true">
              {s.glyph}
            </div>
            <div class="font-space-grotesk font-semibold text-white mb-2.5">
              {s.title}
            </div>
            <div class="font-space-grotesk text-secondary text-sm mb-3.5 leading-relaxed">
              {s.desc}
            </div>
            <div class="flex flex-wrap gap-1.5">
              {s.tags.map((t) => (
                <span class="font-jetbrains-mono text-secondary text-xs bg-background border border-tertiary rounded-md px-2 py-1">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div id="services-footer" class="text-center mt-10 reveal-pending">
      <a href={contactHref} class="font-space-grotesk text-primary cursor-pointer">
        {pillars.footerCta}
      </a>
    </div>
  </div>
</section>

<style>
  .service-card {
    border-left: 1px solid #334155;
    transition:
      background 200ms ease-out,
      border-color 200ms ease-out,
      border-left-width 200ms ease-out,
      transform 200ms ease-out,
      box-shadow 200ms ease-out,
      opacity 300ms ease-out;
  }

  .service-card:hover {
    background: rgba(0, 229, 255, 0.02);
    border-color: rgba(0, 229, 255, 0.5);
    border-left: 2px solid #00e5ff;
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 229, 255, 0.08);
  }
</style>

<script>
  const section = document.getElementById("services-section");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          section
            ?.querySelectorAll(".reveal-pending")
            .forEach((el) => el.classList.add("is-visible"));
          observer.disconnect();
        }
      });
    },
    { threshold: 0.1 },
  );
  if (section) observer.observe(section);
</script>
