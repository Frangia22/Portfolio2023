---
import { formatPeriod, getContent, type Locale } from "../data/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const c = getContent(locale);
const { experience: exp, ui } = c;
---

<section id="experience-section" class="bg-background py-25 px-5 md:px-10 relative">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image:linear-gradient(rgba(0,229,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,0.03) 1px,transparent 1px);background-size:32px 32px;"
  >
  </div>
  <div class="max-w-220 mx-auto">
    <div class="text-center mb-16 text-primary">
      <span class="font-jetbrains-mono text-sm text-primary block mb-3" aria-hidden="true"
        >{exp.sectionLabel}</span
      >
      <h2
        class="font-space-grotesk font-bold text-2xl md:text-4xl text-white mb-1 tracking-tight"
      >
        {exp.title}
      </h2>
      <p class="text-secondary text-base">{exp.subtitle}</p>
    </div>

    <div class="relative">
      <div
        class="absolute left-4.75 top-0 bottom-0 w-0.5 bg-linear-to-b from-transparent via-tertiary to-transparent pointer-events-none overflow-hidden"
        aria-hidden="true"
      >
        <div
          id="timeline-fill"
          class="w-full bg-primary origin-top scale-y-0 transition-transform duration-300 ease-out"
          style="height:100%;transform-origin:top;"
        >
        </div>
      </div>

      <div class="flex flex-col gap-0 mb-10">
        {
          exp.companies.map((company) => (
            <div class="flex gap-2 md:gap-8 pb-10">
              <div class="w-10 flex justify-center pt-4.5">
                <div class="w-2.5 h-2.5 rounded-full bg-primary shadow-md border-2 border-background z-10" />
              </div>
              <div class="flex-1 flex flex-col gap-4">
                <div class="font-space-grotesk font-semibold text-primary text-base">
                  {company.company}
                </div>
                {company.roles.map((role) => (
                  <article class="bg-quinary border border-tertiary rounded-xl px-6 py-7 hover:border-primary hover:shadow-[0px_4px_32px_rgba(0,229,255,0.07)] transition-all duration-200 ease-out">
                    <div class="flex justify-between items-start flex-wrap gap-2 mb-1.5">
                      <div>
                        <h3 class="font-space-grotesk font-semibold text-lg text-white">
                          {role.position}
                        </h3>
                        {role.location && (
                          <div class="font-space-grotesk text-secondary text-sm mt-1">
                            {role.location}
                          </div>
                        )}
                      </div>
                      <div class="flex flex-col items-end gap-1.5">
                        <span class="font-jetbrains-mono text-secondary text-sm">
                          {formatPeriod(role.start, role.end, locale, ui.present)}
                        </span>
                        <span class="font-jetbrains-mono text-secondary text-xs bg-quinary border border-tertiary rounded-md px-2 py-1">
                          {role.mode}
                        </span>
                      </div>
                    </div>
                    <p class="font-space-grotesk text-secondary text-base leading-relaxed mt-4 mb-4">
                      {role.summary}
                    </p>
                    <ul class="list-disc pl-5 flex flex-col gap-2 mb-6 text-secondary text-sm leading-relaxed">
                      {role.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                    <div class="flex flex-wrap gap-2">
                      {role.skills.map((t) => (
                        <span class="font-jetbrains-mono text-primary text-xs bg-quinary border border-tertiary rounded-md px-2 py-1">
                          {t}
                        </span>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid md:grid-cols-3 gap-6 border-t border-tertiary pt-10">
        <div>
          <h3 class="font-space-grotesk font-semibold text-white mb-3">
            {ui.educationHeading}
          </h3>
          <ul class="flex flex-col gap-3 text-sm text-secondary">
            {
              exp.education.map((e) => (
                <li>
                  <div class="text-white font-medium">{e.credential}</div>
                  <div>{e.school}</div>
                  <div class="font-jetbrains-mono text-xs">{e.period}</div>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-space-grotesk font-semibold text-white mb-3">
            {ui.certificationsHeading}
          </h3>
          <ul class="flex flex-col gap-2 text-sm text-secondary">
            {
              exp.certifications.map((cert) => (
                <li>{cert.name}</li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-space-grotesk font-semibold text-white mb-3">
            {ui.languagesHeading}
          </h3>
          <ul class="flex flex-col gap-2 text-sm text-secondary">
            <li>English — {c.profile.englishLevel}</li>
            <li>Spanish — {c.profile.spanishLevel}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const fill = document.getElementById("timeline-fill");
  const section = document.getElementById("experience-section");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fill && section) {
    if (reduce) {
      fill.style.transform = "scaleY(1)";
    } else {
      const onScroll = () => {
        const rect = section.getBoundingClientRect();
        const view = window.innerHeight;
        const total = rect.height + view;
        const progressed = Math.min(1, Math.max(0, (view - rect.top) / total));
        fill.style.transform = `scaleY(${progressed})`;
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }
  }
</script>
