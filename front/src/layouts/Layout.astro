---
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "../components/UI/Footer.astro";
import Navbar from "../components/UI/Navbar.astro";
import Toast from "../components/UI/Toast.astro";
import { getContent, type Locale } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  image?: string;
  canonical?: string;
}

const SITE_URL = "https://devfg.com.ar";
const locale: Locale = Astro.props.locale ?? "en";
const content = getContent(locale);

const {
  title = content.seo.defaultTitle,
  description = content.seo.defaultDescription,
  image = `${SITE_URL}${content.seo.ogImage}`,
  canonical = `${SITE_URL}${Astro.url.pathname}`,
} = Astro.props;

const enPath = getRelativeLocaleUrl("en", Astro.url.pathname.replace(/^\/es/, "") || "/");
const esPath = getRelativeLocaleUrl("es", Astro.url.pathname.replace(/^\/es/, "") || "/");
const enUrl = new URL(enPath, SITE_URL).href;
const esUrl = new URL(esPath, SITE_URL).href;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: content.profile.name,
  url: SITE_URL,
  jobTitle: content.profile.jobTitle,
  worksFor: {
    "@type": "Organization",
    name: content.profile.company,
  },
  description: description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Córdoba",
    addressCountry: "AR",
  },
  knowsLanguage: ["en", "es"],
  sameAs: [content.profile.github, content.profile.linkedin],
  knowsAbout: [
    "React",
    "Next.js",
    "TypeScript",
    "Node.js",
    "Python",
    "LLMs",
    "RAG",
    "AWS",
  ],
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <meta name="description" content={description} />
    <meta name="author" content={content.profile.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "es" ? "es_AR" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={locale === "es" ? "en_US" : "es_AR"}
    />
    <meta property="og:site_name" content={content.seo.siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-K679KZK6");
    </script>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="/FGBlack.png"
      type="image/png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/FGWhite.png"
      type="image/png"
      media="(prefers-color-scheme: light)"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-K679KZK6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <a href="#main" class="skip-link">{content.ui.skipToContent}</a>
    <Navbar locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Toast />
  </body>
</html>
